# Copy to .env and fill in real values. Also add these in Vercel ->
# Project Settings -> Environment Variables for the deployed site.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=

# PhonePe Payment Gateway (server-only — never prefix with NEXT_PUBLIC_)
# 'sandbox' for testing (no real money), 'production' to go live.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# Must match exactly what's configured in PhonePe Business Dashboard ->
# Developer Settings -> Webhooks (Authentication Type: SHA)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# Required so the PhonePe webhook/status routes can update order payment
# status server-side (regular users can't update orders per RLS).
SUPABASE_SERVICE_ROLE_KEY=
