# Copy to .env and fill in real values. Also add these in Vercel ->
# Project Settings -> Environment Variables for the deployed site.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase — used for Phone/SMS OTP verification on the checkout address form,
# and (via the service-account creds below) for the phone login/signup gate.
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only) — verifies the ID token from the phone login/signup
# flow. Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. Paste the private key with literal \n (not real newlines).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cashfree Payment Gateway (server-only — never prefix with NEXT_PUBLIC_)
# 'sandbox' for testing (no real money), 'production' to go live.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree API version header — check the Cashfree dashboard/docs for the current
# recommended value before going live.
CASHFREE_API_VERSION=2023-08-01

# Supabase Dashboard -> Project Settings -> API -> service_role secret.
# Required so the Cashfree webhook/status routes can update order payment
# status server-side (regular users can't update orders per RLS).
SUPABASE_SERVICE_ROLE_KEY=
